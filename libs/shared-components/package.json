{
  "name": "@nestledjs/shared-components",
  "version": "1.0.0",
  "description": "Reusable React components for Nestled framework projects including DataTable and ErrorBoundary",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/**/*",
    "README.md"
  ],
  "keywords": [
    "nestled",
    "react",
    "components",
    "data-table",
    "error-boundary",
    "typescript"
  ],
  "author": "Nestled Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nestledjs/nestled_template.git",
    "directory": "libs/shared-components"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-router": "^7.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.0",
    "json5": "^2.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
