{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./libs/api/prisma"
    },
    {
      "path": "./libs/api/config"
    },
    {
      "path": "./libs/api/core/data-access"
    },
    {
      "path": "./libs/api/core/feature"
    },
    {
      "path": "./libs/api/core/models"
    },
    {
      "path": "./libs/api/core/helpers"
    },
    {
      "path": "./libs/api/custom"
    },
    {
      "path": "./libs/api/smtp-mailer/data-access"
    },
    {
      "path": "./libs/api/generated-crud/data-access"
    },
    {
      "path": "./libs/api/generated-crud/feature"
    },
    {
      "path": "./libs/api/utils"
    }
  ],
  "compilerOptions": {
    "esModuleInterop": true,
    // Every lib under libs/api sets strict: true, but this app is what actually compiles them —
    // lib sources are pulled in through the path mappings in tsconfig.base.json, under THIS
    // config. Leaving it non-strict made the single compilation unit covering the whole API the
    // laxest one, so strict lib code was only ever checked incidentally, via whatever a spec
    // happened to import.
    "strict": true,
    // Required by the source as it already stands: email-hygiene.service.ts imports
    // disposable-email-domains/wildcard.json. webpack resolves that natively, so the build never
    // needed it and `tsc -p` could not even start without it.
    "resolveJsonModule": true
  }
}
